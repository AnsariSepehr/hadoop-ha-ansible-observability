<?xml version="1.0" encoding="UTF-8"?>
<!-- {{ ansible_managed }} -->
<configuration>
  <property><name>dfs.nameservices</name><value>{{ hdfs_nameservice }}</value></property>
  <property><name>dfs.ha.namenodes.{{ hdfs_nameservice }}</name><value>{{ hdfs_nn_ids | join(',') }}</value></property>
{% for h in groups['namenodes'] %}
  <property><name>dfs.namenode.rpc-address.{{ hdfs_nameservice }}.nn{{ loop.index }}</name><value>{{ hostvars[h].node_addr }}:{{ hdfs_nn_rpc_port }}</value></property>
  <property><name>dfs.namenode.http-address.{{ hdfs_nameservice }}.nn{{ loop.index }}</name><value>{{ hostvars[h].node_addr }}:{{ hdfs_nn_http_port }}</value></property>
{% if hadoop_ssl_enabled | bool %}
  <property><name>dfs.namenode.https-address.{{ hdfs_nameservice }}.nn{{ loop.index }}</name><value>{{ hostvars[h].node_addr }}:{{ hdfs_nn_https_port }}</value></property>
{% endif %}
{% endfor %}
  <property><name>dfs.namenode.shared.edits.dir</name><value>{{ hdfs_journal_uri }}</value></property>
  <property><name>dfs.journalnode.edits.dir</name><value>{{ hdfs_jn_dir }}</value></property>
  <property><name>dfs.journalnode.rpc-address</name><value>0.0.0.0:{{ hdfs_jn_rpc_port }}</value></property>
  <property><name>dfs.journalnode.http-address</name><value>0.0.0.0:{{ hdfs_jn_http_port }}</value></property>
  <property><name>dfs.client.failover.proxy.provider.{{ hdfs_nameservice }}</name><value>org.apache.hadoop.hdfs.server.namenode.ha.ConfiguredFailoverProxyProvider</value></property>
  <property><name>dfs.ha.automatic-failover.enabled</name><value>true</value></property>
  <property><name>dfs.ha.zkfc.port</name><value>{{ hdfs_zkfc_rpc_port }}</value></property>
  <property><name>dfs.ha.fencing.methods</name><value>{{ hdfs_fencing_methods | join('\n') }}</value></property>
  <property><name>dfs.ha.fencing.ssh.private-key-files</name><value>{{ hadoop_user_home }}/.ssh/id_rsa</value></property>
  <property><name>dfs.ha.fencing.ssh.connect-timeout</name><value>30000</value></property>
  <property><name>dfs.replication</name><value>{{ hdfs_replication }}</value></property>
  <property><name>dfs.namenode.name.dir</name><value>file://{{ hdfs_nn_dir }}</value></property>
  <property><name>dfs.datanode.data.dir</name><value>file://{{ hdfs_dn_dir }}</value></property>
  <property><name>dfs.datanode.address</name><value>0.0.0.0:{{ hdfs_dn_data_port }}</value></property>
  <property><name>dfs.datanode.http.address</name><value>0.0.0.0:{{ hdfs_dn_http_port }}</value></property>
  <property><name>dfs.permissions.superusergroup</name><value>{{ hadoop_group }}</value></property>
{% if address_mode == 'ip' %}
  <property><name>dfs.namenode.datanode.registration.ip-hostname-check</name><value>false</value></property>
{% endif %}
{% if hadoop_ssl_enabled | bool %}
  <property><name>dfs.http.policy</name><value>HTTPS_ONLY</value></property>
  <property><name>dfs.datanode.https.address</name><value>0.0.0.0:{{ hdfs_dn_https_port }}</value></property>
  <property><name>dfs.client.https.need-auth</name><value>false</value></property>
{% endif %}
</configuration>
