---
# Copy to secrets.yml, replace every CHANGE_ME, then encrypt:
#   cp inventory/group_vars/all/secrets.yml.example inventory/group_vars/all/secrets.yml
#   ansible-vault encrypt inventory/group_vars/all/secrets.yml
# secrets.yml is git-ignored. Never commit it, even encrypted.
mysql_root_password: "CHANGE_ME_root"
mysql_repl_password: "CHANGE_ME_repl"
mysql_hive_password: "CHANGE_ME_hive"
# Needed only when hadoop_ssl_enabled is true (at least 6 characters, use a long random value):
ssl_keystore_password: "CHANGE_ME_keystore"
