# {{ ansible_managed }}
tickTime={{ zookeeper_tick_time }}
initLimit={{ zookeeper_init_limit }}
syncLimit={{ zookeeper_sync_limit }}
dataDir={{ zookeeper_data_dir }}
clientPort={{ zookeeper_client_port }}
maxClientCnxns={{ zookeeper_max_client_cnxns }}
autopurge.snapRetainCount={{ zookeeper_autopurge_retain }}
autopurge.purgeInterval={{ zookeeper_autopurge_hours }}
4lw.commands.whitelist=ruok,srvr,stat,mntr
admin.enableServer=true
admin.serverPort={{ zookeeper_admin_port }}
{% for h in groups['zookeepers'] %}
server.{{ loop.index }}={{ hostvars[h].node_addr }}:{{ zookeeper_peer_port }}:{{ zookeeper_election_port }}
{% endfor %}
