[Unit]
Description=Apache ZooKeeper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ hadoop_user }}
Group={{ hadoop_group }}
Environment=JAVA_HOME={{ zookeeper_java_home }}
Environment=ZOOCFGDIR={{ zookeeper_home }}/conf
Environment=ZOOBINDIR={{ zookeeper_home }}/bin
Environment=ZOO_LOG_DIR={{ zookeeper_log_dir }}
Environment=ZOO_LOG4J_PROP=INFO,ROLLINGFILE
ExecStart={{ zookeeper_home }}/bin/zkServer.sh start-foreground
KillSignal=SIGTERM
KillMode=control-group
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=30
LimitNOFILE={{ common_limits_nofile | default(65536) }}
LimitNPROC={{ common_limits_nproc | default(65536) }}

[Install]
WantedBy=multi-user.target
